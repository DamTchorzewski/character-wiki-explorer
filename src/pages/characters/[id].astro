---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { getWiki } from "../../lib/api";
import { count, formatDate, href, label } from "../../lib/format";
import type { Character, Episode } from "../../lib/types";

export const getStaticPaths = (async () => {
  const { characters, episodes } = await getWiki();
  const episodeById = new Map(episodes.map((e) => [e.id, e]));
  return characters.map((character, i) => ({
    params: { id: String(character.id) },
    props: {
      character,
      seen: character.episodes.map((id) => episodeById.get(id)).filter((e): e is Episode => !!e),
      prev: characters[i - 1] ?? null,
      next: characters[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  character: Character;
  seen: Episode[];
  prev: Character | null;
  next: Character | null;
}

const { character: c, seen, prev, next } = Astro.props;
const seasons = [...new Set(seen.map((e) => e.season))].map((season) => ({
  season,
  episodes: seen.filter((e) => e.season === season),
}));
const first = seen[0];
const statusText = c.status === "unknown" ? "Status unknown" : c.status;
const description = `${c.name}: ${c.status === "unknown" ? "status unknown" : c.status.toLowerCase()} ${c.species.toLowerCase()} from ${c.origin.name === "unknown" ? "an unknown place" : c.origin.name}, seen in ${count(seen.length, "episode")} of Rick and Morty.`;
---

<Base title={c.name} description={description} image={c.image}>
  <div class="wrap">
    <a class="back" href={href("characters/")}>
      All characters
    </a>

    <article class="profile">
      <div class="portrait">
        <img
          src={c.image}
          alt={`${c.name}, as drawn in the show`}
          width="300"
          height="300"
          fetchpriority="high"
        />
      </div>

      <div class="identity">
        <h1>{c.name}</h1>
        <p class="status" data-status={c.status}>
          {statusText}
        </p>

        <dl class="facts">
          <div>
            <dt>Species</dt>
            <dd>{c.species}</dd>
          </div>
          {c.type && (
            <div>
              <dt>Type</dt>
              <dd>{c.type}</dd>
            </div>
          )}
          <div>
            <dt>Gender</dt>
            <dd>{label(c.gender)}</dd>
          </div>
          <div>
            <dt>Origin</dt>
            <dd>
              {c.origin.id ? (
                <a href={href(`locations/${c.origin.id}/`)}>{c.origin.name}</a>
              ) : (
                label(c.origin.name)
              )}
            </dd>
          </div>
          <div>
            <dt>Last known location</dt>
            <dd>
              {c.location.id ? (
                <a href={href(`locations/${c.location.id}/`)}>{c.location.name}</a>
              ) : (
                label(c.location.name)
              )}
            </dd>
          </div>
          {first && (
            <div>
              <dt>First seen in</dt>
              <dd>
                <a href={href(`episodes/${first.id}/`)}>{first.name}</a>
                <span class="aside">
                  {first.code}, {formatDate(first.airDate)}
                </span>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </article>

    <section class="appearances" aria-labelledby="appearances">
      <h2 id="appearances" class="section-title">
        Seen in {count(seen.length, "episode")}
      </h2>
      <div class="seasons">
        {seasons.map(({ season, episodes }) => (
          <section class="season" aria-labelledby={`season-${season}`}>
            <h3 id={`season-${season}`}>Season {season}</h3>
            <ul>
              {episodes.map((e) => (
                <li>
                  <a class="chip episode-chip" href={href(`episodes/${e.id}/`)}>
                    <span class="code">E{String(e.number).padStart(2, "0")}</span>
                    {e.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <nav class="pager" aria-label="Other characters">
      {prev && (
        <a href={href(`characters/${prev.id}/`)} rel="prev">
          <small>Previous character</small>
          <strong>{prev.name}</strong>
        </a>
      )}
      {next && (
        <a class="next" href={href(`characters/${next.id}/`)} rel="next">
          <small>Next character</small>
          <strong>{next.name}</strong>
        </a>
      )}
    </nav>
  </div>
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* the portrait sits inside a still portal ring */
  .portrait {
    position: relative;
    aspect-ratio: 1;
    padding: 14px;
    border-radius: 50%;
    background: conic-gradient(
      from 210deg,
      var(--portal-a),
      var(--portal-b),
      var(--portal-c),
      var(--portal-a)
    );
    box-shadow: 0 0 60px -6px var(--portal-glow);
  }
  .portrait::after {
    content: "";
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    border: 2px dashed rgb(255 255 255 / 0.55);
    pointer-events: none;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
  }

  .identity {
    display: grid;
    gap: 1rem;
  }
  .identity h1 {
    font-size: var(--step-5);
    font-weight: 650;
  }
  .identity > .status {
    font-size: var(--step-1);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .facts > div {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }
  dd {
    display: grid;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }
  dd a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  dd a:hover {
    text-decoration-color: currentColor;
  }
  .aside {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-soft);
  }

  .appearances {
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .seasons {
    display: grid;
    gap: 1.5rem;
  }
  .season {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .season h3 {
    font-size: var(--step-1);
    padding-top: 0.35rem;
  }
  .season ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .episode-chip .code {
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .profile {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .portrait {
      width: min(78vw, 320px);
    }
    .identity {
      justify-items: center;
      width: 100%;
    }
    .facts {
      text-align: left;
      width: 100%;
    }
    .season {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
