{
  "name": "rick-and-morty-wiki",
  "version": "1.0.0",
  "description": "An unofficial Rick and Morty wiki: every character, episode and location of the public Rick and Morty API as fast static pages, with instant search and a WebGL portal.",
  "author": "DamReboot IT Damian Chabracki",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://damtchorzewski.github.io/rick-and-morty-wiki/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamTchorzewski/rick-and-morty-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/DamTchorzewski/rick-and-morty-wiki/issues"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "health": "node scripts/health.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
